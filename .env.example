# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Sheets Cloud Database (Google Apps Script Web App v3)
# Dán URL ứng dụng web (/exec) từ Google Apps Script vào biến môi trường này trên Vercel để mọi thiết bị tự động kết nối Google Sheets:
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# Tùy chọn: Link mở trực tiếp file Google Sheet của bạn
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
